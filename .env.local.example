# Supabase — salin file ini menjadi `.env.local` lalu isi nilainya.
# Nilai didapat dari: Dashboard Supabase > Project Settings > API.
#
# PENTING: NEXT_PUBLIC_SUPABASE_URL hanya URL project, TANPA path /rest/v1.
#   Benar : https://xxxxxxxx.supabase.co
#   Salah : https://xxxxxxxx.supabase.co/rest/v1
#
# Kunci boleh memakai format lama (JWT `eyJ...`) maupun format baru
# (`sb_publishable_...` untuk anon, `sb_secret_...` untuk service role).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (HANYA untuk server/admin, JANGAN sampai ke klien):
SUPABASE_SERVICE_ROLE_KEY=

# Fallback admin (opsional). Admin utama ditentukan oleh
# app_metadata.role = "admin" pada user Supabase Auth.
# Isi dengan email admin, pisahkan koma jika lebih dari satu.
ADMIN_EMAILS=

# Nomor WhatsApp admin (ditampilkan untuk pengiriman bukti pembayaran):
NEXT_PUBLIC_WA_ADMIN=
