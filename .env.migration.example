# Salin file ini menjadi `.env.migration.local`, lalu isi nilainya.
# File `.env.migration.local` tidak akan masuk Git.
#
# URL project lama dan baru:
OLD_SUPABASE_URL=
NEW_SUPABASE_URL=

# Service role key project lama dan baru.
# JANGAN memakai anon/publishable key.
OLD_SERVICE_ROLE_KEY=
NEW_SERVICE_ROLE_KEY=

# Set YES hanya saat siap mengosongkan tabel project baru:
CONFIRM_RESET_NEW=
CONFIRM_UPLOAD=